# Agent session state: private CLAUDE_CONFIG_DIR per agent.
# Contains full conversation transcripts (~20 MB) and the mount point for the
# credentials file (bind-mounted read-only at runtime, always 0 bytes on disk).
**/.claudecfg/

# Caches and environments created inside playgrounds
**/.pipcache/
**/.venv/
**/venv/
**/.mplcache/
**/.loprofile/
**/__pycache__/
*.pyc

# LaTeX build artefacts
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out

# Run-local scratch
playground/*.log
playground/*.pid
.last_run.pid
**/.session_id

# Papers an agent downloaded to read: third-party copyrighted material. Each
# downloads.md records the URL and how the file was verified, so a run reproduces
# without shipping them. Validators fetch their own copies into directories of their
# own naming, so match on the filename, not on one directory name.
**/papers/**
**/mypapers/**
**/*papers*/*.pdf

# Environments and datasets an agent built or fetched. A venv for a machine-learning
# assignment runs to hundreds of megabytes, and the dataset is downloaded by the
# notebook's own setup cell, so both are reproducible rather than worth storing.
**/venv/
**/data/task*/
*.csv.gz
*.pkl
*.npy

# Workers build their own environments when the master does not provide a shared
# one, and they name them `.venv` as often as `venv`. Model/feature caches are
# regenerated by the code that wrote them.
**/.venv/
*.pt
*.pth

# Workers name their environment whatever they like -- this run used `.venv-gt`, so
# the exact-name rules above missed 22,089 files. Match any name that starts venv.
**/.venv*/
**/venv*/
**/.pipcache/
**/__pycache__/

# Datasets the notebook's own setup cell downloads. This run fetched ZINC three
# times over, 384 MB per copy, into every agent's playground.
playground/**/data/
