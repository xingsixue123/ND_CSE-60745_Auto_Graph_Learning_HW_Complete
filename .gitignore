# Agent session state: private CLAUDE_CONFIG_DIR per agent.
# Contains full conversation transcripts (~20 MB) and the mount point for the
# credentials file (bind-mounted read-only at runtime, always 0 bytes on disk).
**/.claudecfg/

# Caches and environments created inside playgrounds
**/.pipcache/
**/.venv/
**/venv/
**/.mplcache/
**/.loprofile/
**/__pycache__/
*.pyc

# LaTeX build artefacts
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out

# Run-local scratch
playground/*.log
playground/*.pid
.last_run.pid
**/.session_id

# Papers a worker downloaded to read. Third-party copyrighted material (ACM, USENIX,
# author sites) -- keeping it out of the repository avoids redistributing it. Each
# worker's downloads.md records the exact URL it fetched and how it verified the file
# was the genuine paper, so the run stays reproducible without shipping the PDFs.
**/papers/*.pdf

# The hand-editing workspace: keep the sources and the built PDF, drop the rest.
# (*.log is not ignored globally because run.log and heartbeat.log are wanted.)
draft/*.log
draft/* copy.tex
